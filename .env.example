# No keys required for the fictional demo. Copy to .env and keep it private.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# auto selects Keenable when configured, then Tavily, otherwise local procedures.
# Set local to disable web requests, or explicitly choose keenable / tavily.
SEARCH_PROVIDER=auto
KEENABLE_API_KEY=
TAVILY_API_KEY=
# Stripe accepts test keys only. Link a test charge to a case through the setup script.
STRIPE_SECRET_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
# Notifications default to the local customer portal. Sending SMS is separately enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_RECIPIENT=
ENABLE_SMS=false
BANK_REVIEW_THRESHOLD_CENTS=50000

# Hosted portfolio demo (Render + private Supabase schema).
REFUND_HOSTED=false
REFUND_PUBLIC_URL=
REFUND_ACCESS_PASSWORD=
DATABASE_URL=
# Supabase session pooler (5432); required for durable LangGraph checkpoints.
CHECKPOINT_DATABASE_URL=

